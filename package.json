{
  "name": "stencil-starter",
  "version": "0.0.1",
  "description": "Stencil Component Starter",
  "main": "dist/index.cjs.js",
  "module": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "collection": "dist/collection/collection-manifest.json",
  "collection:main": "dist/collection/index.js",
  "unpkg": "dist/stencil-starter/stencil-starter.esm.js",
  "exports": {
    ".": {
      "import": "./dist/stencil-starter/stencil-starter.esm.js",
      "require": "./dist/stencil-starter/stencil-starter.cjs.js"
    },
    "./my-component": {
      "import": "./dist/components/my-component.js",
      "types": "./dist/components/my-component.d.ts"
    },
    "./loader": {
      "import": "./loader/index.js",
      "require": "./loader/index.cjs",
      "types": "./loader/index.d.ts"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/stenciljs/component-starter.git"
  },
  "files": [
    "dist/",
    "loader/"
  ],
  "scripts": {
    "build": "stencil build",
    "start": "stencil build --dev --watch --serve",
    "start:custom-elements": "concurrently \"stencil build --dev --watch\" \"browser-sync start --server --files 'dist/**/*' 'custom-elements.html' --index custom-elements.html --logLevel silent\"",
    "test": "stencil test --spec",
    "test:watch": "stencil test --spec --watchAll",
    "generate": "stencil generate"
  },
  "devDependencies": {
    "@stencil/core": "latest",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.5",
    "browser-sync": "^3.0.4",
    "concurrently": "^9.2.1",
    "jest": "^29.7.0",
    "jest-cli": "^29.7.0",
    "puppeteer": "^24.3.0"
  },
  "license": "MIT"
}
